{
  "name": "@spora/seo-outreach",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "bin": {
    "seo-outreach": "./dist/cli.js",
    "outreach-crawl": "./dist/compat/cli.js",
    "outreach-sites": "./dist/compat/cli/sites.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./reports": {
      "types": "./dist/reports/index.d.ts",
      "import": "./dist/reports/index.js"
    },
    "./reports/*": {
      "types": "./dist/reports/*.d.ts",
      "import": "./dist/reports/*.js"
    },
    "./compat/*": {
      "types": "./dist/compat/*.d.ts",
      "import": "./dist/compat/*.js"
    },
    "./handoff": {
      "types": "./dist/handoff.d.ts",
      "import": "./dist/handoff.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "compat-profiles.json",
    "scripts",
    "tests/fixtures/report-golden",
    "THIRD_PARTY_NOTICES.md",
    "docs",
    "report-design.lock.json"
  ],
  "scripts": {
    "build": "pnpm check:pdf-design && node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.json",
    "typecheck": "pnpm check:pdf-design && tsc -p tsconfig.json --noEmit",
    "test": "pnpm build && node --test --test-concurrency=2 tests/*.test.mjs",
    "outreach-crawl": "node dist/compat/cli.js",
    "outreach-sites": "node dist/compat/cli/sites.js",
    "check:pdf-design": "node scripts/check-report-design.mjs",
    "test:visual": "pnpm check:pdf-design && node scripts/check-report-visuals.mjs --self-test",
    "prepack": "pnpm check:pdf-design"
  },
  "devDependencies": {
    "@types/node": "24.10.0",
    "typescript": "5.9.3"
  },
  "packageManager": "pnpm@10.29.3",
  "dependencies": {
    "@spora/webcrawl": "workspace:*",
    "parse5": "7.3.0"
  },
  "optionalDependencies": {
    "playwright": "1.64.1"
  }
}
